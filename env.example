# Copy to .env and fill in. deploy.sh does this on first deploy
# (and generates a random PLAUDIUS_TOKEN).

# Static bearer token the iPhone Shortcut sends (Authorization: Bearer <token>).
PLAUDIUS_TOKEN=change-me

# Hosted engines
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ntfy (self-hosted). Leave NTFY_URL empty to disable pushes.
NTFY_URL=
NTFY_TOPIC=plaudius
NTFY_TOKEN=

# Obsidian vault name as it appears in the Obsidian app (used in the obsidian:// click URI)
OBSIDIAN_VAULT=vault

# Paths
VAULT_DIR=/data/vault/briefs
DATA_DIR=data

# Server
HOST=0.0.0.0
PORT=8321
MAX_UPLOAD_MB=500
